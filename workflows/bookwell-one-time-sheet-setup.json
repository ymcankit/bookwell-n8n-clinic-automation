{
  "name": "BookWell – One-time Sheet Setup",
  "nodes": [
    {
      "id": "n1",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -220
      ],
      "parameters": {
        "content": "## One-time setup\nClick **Execute workflow** once. It creates the *BookWell Demo* spreadsheet with **Patients** and **Waitlist** tabs and 4 fictional waitlist people.\nCopy **spreadsheetId** from the last node's output into **Clinic Config** in the other workflows. The Patients header row is written by the first booking.",
        "width": 1120,
        "height": 160,
        "color": 5
      }
    },
    {
      "id": "s1",
      "name": "Run Setup",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "s2",
      "name": "Create Spreadsheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        240,
        0
      ],
      "parameters": {
        "resource": "spreadsheet",
        "operation": "create",
        "title": "BookWell Demo",
        "sheetsUi": {
          "sheetValues": [
            {
              "title": "Patients"
            },
            {
              "title": "Waitlist"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "s3",
      "name": "Waitlist Seed Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Fictional waitlist patients (made-up data only)\nconst people = [\n  ['WL-001','Maya Chen','maya.chen@example.com','(555) 010-2001','New patient visit','Morning'],\n  ['WL-002','Daniel Brooks','daniel.brooks@example.com','(555) 010-2002','Follow-up','Afternoon'],\n  ['WL-003','Aisha Rahman','aisha.rahman@example.com','(555) 010-2003','Annual check-up','Morning'],\n  ['WL-004','Tom Novak','tom.novak@example.com','(555) 010-2004','Other','Afternoon'],\n];\nreturn people.map(([id, name, email, phone, reason, time], i) => ({ json: {\n  waitlistId: id, fullName: name, email, phone, reason, preferredTime: time,\n  addedAt: new Date(Date.now() - (people.length - i) * 86400000).toISOString().slice(0, 10),\n  status: 'Waiting', notifiedAt: '',\n}}));"
      }
    },
    {
      "id": "s4",
      "name": "Write Waitlist",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        720,
        0
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Create Spreadsheet').first().json.spreadsheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Waitlist"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "s5",
      "name": "Return IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const s = $('Create Spreadsheet').first().json;\nreturn [{ json: { spreadsheetId: s.spreadsheetId, spreadsheetUrl: s.spreadsheetUrl, waitlistRows: $input.all().length } }];"
      }
    }
  ],
  "connections": {
    "Run Setup": {
      "main": [
        [
          {
            "node": "Create Spreadsheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Spreadsheet": {
      "main": [
        [
          {
            "node": "Waitlist Seed Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Waitlist Seed Data": {
      "main": [
        [
          {
            "node": "Write Waitlist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write Waitlist": {
      "main": [
        [
          {
            "node": "Return IDs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}